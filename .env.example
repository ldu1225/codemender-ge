# ==============================================================================
# 🛡️ CodeMender Security Agent for Gemini Enterprise — Customer Configuration
# ==============================================================================
# Quickstart:
#   1. Copy this file:  cp .env.example .env
#   2. Edit GOOGLE_CLOUD_PROJECT (and optionally GE_ENGINE_ID) below
#   3. Deploy & Register in 1 command:  ./scripts/deploy_and_register_ge.sh
# ==============================================================================

# [REQUIRED] 1. Your Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# [OPTIONAL] 2. Gemini Enterprise (Discovery Engine) Configuration
# - GE_LOCATION: Multi-region of your Gemini Enterprise app ("us", "eu", or "global")
# - GE_ENGINE_ID: Your Gemini Enterprise Engine ID (e.g., "gemini-enterprise_1234567890").
#   💡 Leave GE_ENGINE_ID blank ("") to let ./scripts/deploy_and_register_ge.sh
#   automatically discover the active Gemini Enterprise engine in your project!
GE_LOCATION="us"
GE_ENGINE_ID=""

# [OPTIONAL] 3. Cloud Run & GEAP Settings
CLOUD_RUN_REGION="us-central1"
GOOGLE_CLOUD_LOCATION="global"
SERVICE_NAME="codemender-ge"
AGENT_DISPLAY_NAME="CodeMender Security Agent (Gemini 3.8 Flash)"

# [OPTIONAL] 4. CodeMender Reasoning & Judge Models
CODEMENDER_MODEL="gemini-3.8-flash"
CODEMENDER_FALLBACK_MODEL="gemini-3.7-flash"
CM_USD_TO_KRW_RATE="1380.0"

# [OPTIONAL] 5. GCS Bucket for 1-Click Patched File Downloads & Per-Session Snapshots (encrypted auth)
# Defaults to "${GOOGLE_CLOUD_PROJECT}-a2a-bucket" if left blank.
# Lifecycle rules are applied automatically: sessions/ 1 day, codemender-patches/ 7 days.
CM_GCS_ARTIFACT_BUCKET=""

# [OPTIONAL] 6. GitHub Integration & Session Security (AES-256-GCM Encryption & TTL)
# - Leave blank ("") to use standard GitHub CLI Device Flow (`cm github login`),
#   or enter your organization's custom GitHub OAuth App Client ID / PAT.
# - Tokens are encrypted at rest with session-bound AES-256-GCM (`cm_aead_v1:`) and auto-expire after TTL.
# - The encryption master key is auto-generated by ./scripts/deploy_and_register_ge.sh in Secret Manager
#   (`codemender-token-encryption-key`) and injected as CM_TOKEN_ENCRYPTION_KEY. Do NOT set it here.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_TOKEN=""
CM_GITHUB_TOKEN_TTL_SECONDS="43200"
CM_SESSION_TTL_SECONDS="43200"

